    "notes": [
      "512 bounces: multiple scattering converges there (1024 identical); 16 bounces left BACK bodies at about 12 % of their converged sun light",
      "extinction 0.10/m (round 1: 0.07): crisper domes at the 2.2-5x magnification the cards are drawn at; 0.07, 0.095 and 0.12 were compared",
      "HG 0.6 kept: the dual lobe 0.7 HG(0.8) + 0.3 HG(-0.2) darkened BACK bodies by about 15 % and turned them bluer (B/R 1.08 -> 1.18 on cell 6) for under 2 % change in FRONT"
    ]
  },
  "runtime": {
    "formula": "rgb = Exposure * (sunL(phi) * SunTint + skyL * AmbTint); alpha = aux.G",
    "sunL_phi_as_built": "phi <= 20: R; 20..90: lerp(R, G, (phi - 20) / 70); 90..160: lerp(G, B, (phi - 90) / 70); >= 160: B (M_SemiCelCloud today)",
    "sunL_phi_recommended": "20..90: lerp(R, G, 1 - (1 - t)^2), t = (phi - 20) / 70, so the BACK rim fades as fast as forward scattering does (at phi 40 the rim keeps 51 % instead of 71 %); 90..160 linear. In M_SemiCelCloud: wB = 1 - saturate((phi - 20) / 70); wB = wB * wB",
    "SunTint": "linear(#FFB88C) * 1.60",
    "AmbTint": "linear(#8784BA) * 0.90",
    "Exposure_recommended": 1.058,
    "Exposure_basis": "median front-lit opaque cloud luminance = 1.3 x the #8F94BA preview sky (the reference's ratio)",
    "CumulusSkyNorm": 1.0,
    "notes": [
      "set CardExposure to Exposure_recommended (round 1 shipped 0.58 for unscaled sun channels)",
      "keep CumulusSkyNorm 1.0: the physical sun/sky balance is baked into sun_scale",
      "M_SemiCelCloud also lerps toward HazeColor by Haze * (1 - exp(-dist / HazeDistance)) * 0.85, which this formula and the look sheet leave out; it moves cards 15 km and further toward pink"
    ],
    "skyL": "aux.R as stored (already scaled by sky_factor)",
    "mirror": "sample u' = 1 - u inside the cell when the sun is on the card's -u side"
  },
